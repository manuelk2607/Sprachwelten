DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/DATABASE/auth
NEON_AUTH_COOKIE_SECRET=GENERATE_WITH_OPENSSL_RAND_BASE64_48

# Translation suggestions use the Cloudflare AI binding (configured in vite.config.ts).
# No separate translation API key is needed.

# Optional public Google Search Console verification code (not your Google password).
# GOOGLE_SITE_VERIFICATION=YOUR_HTML_TAG_CONTENT

# Real auth verification: put ONLY a dedicated test account in ignored
# .env.auth-test.local, then npm run test:live-auth. No signup or grants occur.
# AUTH_TEST_EMAIL=your-test-account@example.com
# AUTH_TEST_PASSWORD=your-test-password
# Real AI additionally requires explicit consent and -- --allow-ai (max 4 calls).
