{
  "name": "sprachwelten",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "qa:integration": "node --import tsx scripts/qa-integration.mts",
    "test:editorial-integration": "node --import tsx scripts/test-editorial-integration.mts",
    "dev": "node scripts/run-framework.mts dev",
    "build": "node scripts/run-framework.mts build",
    "start": "node --import ./scripts/sites-env.mts ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "test:integration": "node --env-file-if-exists=.env.test.local --import tsx scripts/smoke.mts",
    "test:game-integration": "node --import tsx scripts/test-game-redesign.mts",
    "test:learning-integration": "node --import tsx scripts/test-learning-integration.mts",
    "test:notebooks-integration": "node --import tsx scripts/test-notebooks-integration.mts",
    "db:seed-learning": "node --env-file=.env.local --import tsx scripts/seed-learning.mts",
    "test:live-auth": "node --env-file-if-exists=.env.auth-test.local --import tsx scripts/test-live-auth-ai.mts",
    "deploy:cloudflare": "node --env-file=.env.local scripts/deploy-cloudflare.mts",
    "deploy:worlds-pilot": "node --import tsx scripts/deploy-worlds-pilot.mts",
    "worlds:report-migrations": "node --import tsx scripts/report-worlds-migrations.mts",
    "test:browser": "playwright test",
    "check:translations": "tsx scripts/list-missing-translations.mts --check",
    "audit:dependencies": "tsx scripts/audit-dependencies.mts",
    "test:worlds-browser": "node --import tsx node_modules/@playwright/test/cli.js test --config playwright.worlds.config.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "@worlds-hub/auth": "https://codeload.github.com/manuelk2607/Worlds-Hub/tar.gz/ad8704848f409009b78f5c3b6121e5f6d12c6ba1",
    "lucide-react": "^1.31.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.2"
  },
  "type": "module",
  "overrides": {
    "zod": "$zod",
    "undici": "7.30.1",
    "minimatch@^10.0.0": "11.0.1",
    "fast-uri": "3.1.9",
    "miniflare": {
      "sharp": "0.35.5"
    },
    "fflate": "0.7.5",
    "better-auth": "1.7.14",
    "@better-auth/core": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "@better-auth/api-key": "1.7.14",
    "@react-email/render": "2.2.0",
    "better-call": "1.4.4",
    "@better-fetch/fetch": "1.3.3"
  }
}
