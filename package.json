{
  "name": "sprachwelten",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/run-framework.mts dev",
    "build": "node scripts/run-framework.mts build",
    "start": "node --import ./scripts/sites-env.mts ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "test:integration": "node --env-file=.env.test.local --import tsx scripts/smoke.mts",
    "deploy:cloudflare": "node --env-file=.env.local scripts/deploy-cloudflare.mts",
    "test:browser": "playwright test",
    "check:translations": "tsx scripts/list-missing-translations.mts --check",
    "audit:dependencies": "tsx scripts/audit-dependencies.mts"
  },
  "dependencies": {
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "lucide-react": "^1.31.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.2"
  },
  "type": "module",
  "overrides": {
    "zod": "$zod",
    "undici": "7.30.1",
    "fast-uri": "3.1.9",
    "miniflare": {
      "sharp": "0.35.5"
    },
    "fflate": "0.7.5"
  }
}
