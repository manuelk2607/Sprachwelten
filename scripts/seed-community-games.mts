import {neon} from '@neondatabase/serverless';
import {communityGameEntries} from '../lib/community-game-seeds';
const sql=neon(process.env.DATABASE_URL_UNPOOLED!);let inserted=0;
for(const e of communityGameEntries){const rows=await sql`INSERT INTO content_entries(id,kind,phrase,language,literal,meaning,example,region,cultural_note,context,source_url,author_name,credit_name,status,source_locale,translations,challenge) VALUES (${e.id},${e.kind},${e.phrase},${e.language},${e.literal},${e.meaning},${e.example},${e.region},${e.culturalNote},${e.context},${e.sourceUrl},${e.authorName},${e.creditName??''},'curated','de',${JSON.stringify(e.translations??{})}::jsonb,${JSON.stringify(e.challenge)}::jsonb) ON CONFLICT(id) DO UPDATE SET challenge=excluded.challenge,revision=content_entries.revision+1,updated_at=now() WHERE content_entries.status='curated' AND content_entries.updated_at IS NULL AND content_entries.phrase=excluded.phrase AND content_entries.meaning=excluded.meaning AND content_entries.challenge IS DISTINCT FROM excluded.challenge RETURNING id`;inserted+=rows.length;}
console.log(`${inserted} kuratierte Spielkarten ergänzt oder behutsam aktualisiert.`);
